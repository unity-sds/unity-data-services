{
  "Version": "2008-10-17",
  "Id": "__default_policy_ID",
  "Statement": [
    {
      "Sid": "1",
      "Effect": "Allow",
      "Principal": {
        "Service": ["lambda.amazonaws.com"]
      },
      "Action": [
        "SNS:GetTopicAttributes",
        "SNS:SetTopicAttributes",
        "SNS:AddPermission",
        "SNS:RemovePermission",
        "SNS:DeleteTopic",
        "SNS:Subscribe",
        "SNS:ListSubscriptionsByTopic",
        "SNS:Publish"
      ],
      "Resource": "${sns_arn}"
    },

    {
      "Sid": "AllowCumulusUat3LambdaProcessingPublish",
      "Effect": "Allow",
      "Principal": {
        "AWS": "${daac_lambda_2_sns_role}"
      },
      "Action": "SNS:Publish",
      "Resource": "${sns_arn}"
    }
  ]
}
